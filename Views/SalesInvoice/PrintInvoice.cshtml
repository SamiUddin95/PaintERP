@model PaintERP.Models.Entities.SalesInvoice
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
        }
        .print-button {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 10px 20px;
            background: #333;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
        @@media print {
            .print-button { display: none; }
            body { padding: 0; }
            .invoice-container { max-width: 100%; }
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
</head>
<body>
    <button class="print-button" onclick="window.print()">Print Invoice</button>

    <div class="invoice-container">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px; border-bottom: 3px solid #333; padding-bottom: 20px;">
            <tr>
                <td width="50%" valign="top">
                    <h1 style="font-size: 24px; color: #333; margin: 0 0 5px 0;">Unicorp Bissonet</h1>
                    <p style="margin: 2px 0; font-size: 11px; color: #666;">123 Industrial Boulevard</p>
                    <p style="margin: 2px 0; font-size: 11px; color: #666;">Paint City, PC 12345</p>
                    <p style="margin: 2px 0; font-size: 11px; color: #666;">Phone: (555) 123-4567</p>
                    <p style="margin: 2px 0; font-size: 11px; color: #666;">Email: info@unicorpbissonet.com</p>
                </td>
                <td width="50%" valign="top" align="right">
                    <h2 style="font-size: 28px; color: #e74c3c; margin: 0 0 10px 0;">INVOICE</h2>
                    <span style="background: #27ae60; color: white; padding: 4px 12px; font-size: 10px; font-weight: bold; text-transform: uppercase;">@Model.Status</span>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
            <tr>
                <td align="right">
                    <span style="font-weight: bold; color: #333;">Invoice #:</span> @Model.InvoiceNumber<br />
                    <span style="font-weight: bold; color: #333;">Invoice Date:</span> @Model.InvoiceDate.ToString("MMMM dd, yyyy")<br />
                    @if (Model.DueDate.HasValue)
                    {
                        <span style="font-weight: bold; color: #333;">Due Date:</span> @Model.DueDate.Value.ToString("MMMM dd, yyyy")<br />
                    }
                    <span style="font-weight: bold; color: #333;">Salesperson:</span> @Model.Salesperson<br />
                    <span style="font-weight: bold; color: #333;">Reference:</span> @Model.ReferenceNumber
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
            <tr>
                <td width="50%" valign="top" style="padding-right: 30px;">
                    <h3 style="font-size: 12px; color: #333; margin: 0 0 10px 0; text-transform: uppercase;">Bill To</h3>
                    <strong>@Model.Customer?.BusinessName</strong><br />
                    @if (!string.IsNullOrEmpty(Model.Customer?.BillingStreetAddress))
                    {
                        @Model.Customer.BillingStreetAddress<br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer?.BillingCity))
                    {
                        @Model.Customer.BillingCity<br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer?.BillingState))
                    {
                        @Model.Customer.BillingState<br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer?.BillingZipCode))
                    {
                        @Model.Customer.BillingZipCode<br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer?.ContactOfficePhone))
                    {
                        @:Phone: @Model.Customer.ContactOfficePhone<br />
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer?.ContactEmail))
                    {
                        @:Email: @Model.Customer.ContactEmail
                    }
                </td>
                <td width="50%" valign="top" style="padding-left: 10px;">
                    <h3 style="font-size: 12px; color: #333; margin: 0 0 10px 0; text-transform: uppercase;">Ship To</h3>
                    <strong>@Model.Customer?.BusinessName</strong><br />
                    @if (Model.Warehouse != null)
                    {
                        @Model.Warehouse.Name<br />
                        @Model.Warehouse.Location
                    }
                    else
                    {
                        <span>Same as billing address</span>
                    }
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="10" cellspacing="0" border="1" style="border-collapse: collapse; margin-bottom: 20px; border: 1px solid #ddd;">
            <tr style="background: #333; color: white;">
                <th style="text-align: left; font-size: 10px; padding: 10px;">SKU</th>
                <th style="text-align: left; font-size: 10px; padding: 10px;">Description</th>
                <th style="text-align: center; font-size: 10px; padding: 10px; width: 60px;">Qty</th>
                <th style="text-align: center; font-size: 10px; padding: 10px; width: 60px;">Unit</th>
                <th style="text-align: right; font-size: 10px; padding: 10px; width: 80px;">Price</th>
                <th style="text-align: right; font-size: 10px; padding: 10px; width: 70px;">Disc %</th>
                <th style="text-align: right; font-size: 10px; padding: 10px; width: 70px;">Tax %</th>
                <th style="text-align: right; font-size: 10px; padding: 10px; width: 90px;">Total</th>
            </tr>
            @foreach (var item in Model.SalesInvoiceItems)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px; font-size: 11px;">@item.SKU</td>
                    <td style="padding: 10px; font-size: 11px;">@item.Description</td>
                    <td style="padding: 10px; font-size: 11px; text-align: center;">@item.Quantity.ToString("N2")</td>
                    <td style="padding: 10px; font-size: 11px; text-align: center;">@item.Unit</td>
                    <td style="padding: 10px; font-size: 11px; text-align: right;">@item.UnitPrice.ToString("C")</td>
                    <td style="padding: 10px; font-size: 11px; text-align: right;">@item.DiscountPercent.ToString("N2")%</td>
                    <td style="padding: 10px; font-size: 11px; text-align: right;">@item.TaxPercent.ToString("N2")%</td>
                    <td style="padding: 10px; font-size: 11px; text-align: right;">@item.LineTotal.ToString("C")</td>
                </tr>
            }
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td>&nbsp;</td>
                <td width="300" valign="top" align="right">
                    <table width="300" cellpadding="8" cellspacing="0" border="0">
                        <tr>
                            <td align="left" style="font-size: 11px; color: #666;">Subtotal</td>
                            <td align="right" style="font-size: 11px; font-weight: bold; color: #333;">@Model.Subtotal.ToString("C")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; color: #666;">Discount</td>
                            <td align="right" style="font-size: 11px; font-weight: bold; color: #333;">-@Model.DiscountAmount.ToString("C")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; color: #666;">Shipping</td>
                            <td align="right" style="font-size: 11px; font-weight: bold; color: #333;">@Model.ShippingCost.ToString("C")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; color: #666;">Sales Tax</td>
                            <td align="right" style="font-size: 11px; font-weight: bold; color: #333;">@Model.SalesTaxAmount.ToString("C")</td>
                        </tr>
                        <tr style="background: #333; color: white;">
                            <td align="left" style="font-size: 13px; font-weight: bold; padding: 12px 8px;">GRAND TOTAL</td>
                            <td align="right" style="font-size: 16px; font-weight: bold; padding: 12px 8px;">@Model.GrandTotal.ToString("C")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; color: #666;">Amount Paid</td>
                            <td align="right" style="font-size: 11px; font-weight: bold; color: #333;">@Model.AmountPaid.ToString("C")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; font-weight: bold; color: #333;">BALANCE DUE</td>
                            <td align="right" style="font-size: 14px; font-weight: bold; color: #e74c3c;">@Model.BalanceDue.ToString("C")</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        @if (!string.IsNullOrEmpty(Model.CustomerNotes) || !string.IsNullOrEmpty(Model.InternalNotes))
        {
            <div style="margin: 20px 0; padding: 15px; background: #f5f5f5; border-left: 4px solid #333;">
                <h3 style="font-size: 11px; color: #333; margin: 0 0 8px 0; text-transform: uppercase;">Notes</h3>
                @if (!string.IsNullOrEmpty(Model.CustomerNotes))
                {
                    <p style="margin: 5px 0; font-size: 11px;"><strong>Customer Notes:</strong> @Model.CustomerNotes</p>
                }
                @if (!string.IsNullOrEmpty(Model.InternalNotes))
                {
                    <p style="margin: 5px 0; font-size: 11px;"><strong>Internal Notes:</strong> @Model.InternalNotes</p>
                }
            </div>
        }

        <div style="margin: 20px 0; padding: 15px; background: #f5f5f5; border-left: 4px solid #333;">
            <h3 style="font-size: 11px; color: #333; margin: 0 0 8px 0; text-transform: uppercase;">Payment Information</h3>
            <p style="margin: 5px 0; font-size: 11px;"><strong>Payment Terms:</strong> @Model.PaymentTerms</p>
            <p style="margin: 5px 0; font-size: 11px;"><strong>Shipping Method:</strong> @Model.ShippingMethod</p>
            @if (!string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <p style="margin: 5px 0; font-size: 11px;"><strong>Tracking Number:</strong> @Model.TrackingNumber</p>
            }
        </div>

        <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; text-align: center; font-size: 10px; color: #999;">
            <p style="margin: 5px 0;">Thank you for your business!</p>
            <p style="margin: 5px 0;">For questions regarding this invoice, please contact us at (555) 123-4567 or info@usapainterp.com</p>
            <p style="margin: 5px 0;">Generated on @DateTime.UtcNow.ToString("MMMM dd, yyyy HH:mm") UTC</p>
        </div>
    </div>
</body>
</html>
