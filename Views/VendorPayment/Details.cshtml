@model PaintERP.Models.Entities.VendorPayment
@{
    ViewData["Title"] = "Vendor Payment Details";
}

<link rel="stylesheet" href="/css/bill.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Vendor Payment Details</h1>
            <p class="page-subtitle">@Model.PaymentNumber - (@Model.TotalPaymentAmount.ToString("C"))</p>
        </div>
        <div class="header-right">
            <a class="btn btn-secondary" asp-action="Index">
                <i class="icon-arrow-left"></i>
                Back to Payments
            </a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="icon-edit"></i> Edit
            </a>
        </div>
    </div>

    <div class="bill-layout">
        <div class="bill-main">
            <!-- Payment Header -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Payment Information</div>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Vendor</label>
                            <input value="@Model.Vendor?.BusinessName" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Payment Number</label>
                            <input value="@Model.PaymentNumber" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Payment Date</label>
                            <input value="@Model.PaymentDate.ToString("MM/dd/yyyy")" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Payment Method</label>
                            <input value="@Model.PaymentMethod" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Bank Account</label>
                            <input value="@Model.BankAccount" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Reference Number</label>
                            <input value="@Model.ReferenceNumber" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Total Payment Amount</label>
                            <input value="@Model.TotalPaymentAmount.ToString("C")" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <input value="@Model.Status" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bills -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Applied Bills</div>
                </div>
                <div class="card-body">
                    <div class="items-grid">
                        <div class="items-header">
                            <div class="col-bill">Bill Number</div>
                            <div class="col-amount">Bill Amount</div>
                            <div class="col-amount-due">Amount Due</div>
                            <div class="col-payment">Payment Amount</div>
                            <div class="col-remaining">Remaining Balance</div>
                        </div>
                        @foreach (var bill in Model.VendorPaymentBills)
                        {
                            <div class="item-row">
                                <div class="col-bill">@bill.Bill?.BillNumber</div>
                                <div class="col-amount">@bill.BillAmount.ToString("C")</div>
                                <div class="col-amount-due">@bill.AmountDue.ToString("C")</div>
                                <div class="col-payment">@bill.PaymentAmount.ToString("C")</div>
                                <div class="col-remaining">@bill.RemainingBalance.ToString("C")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Summary -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Payment Summary</div>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Total Applied</label>
                            <input value="@Model.TotalApplied.ToString("C")" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Unapplied Amount</label>
                            <input value="@Model.UnappliedAmount.ToString("C")" class="form-control" readonly />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="form-group">
                            <label>Notes</label>
                            <textarea class="form-control" rows="3" readonly>@Model.Notes</textarea>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="bill-sidebar">
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Status</div>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Payment Status</label>
                        <input value="@Model.Status" class="form-control" readonly />
                    </div>
                    @if (Model.ReconciledDate.HasValue)
                    {
                        <div class="form-group">
                            <label>Reconciled Date</label>
                            <input value="@Model.ReconciledDate.Value.ToString("MM/dd/yyyy")" class="form-control" readonly />
                        </div>
                    }
                </div>
            </div>

            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Actions</div>
                </div>
                <div class="card-body">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-block">
                        <i class="icon-edit"></i> Edit Payment
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-block mt-2">
                        <i class="icon-trash"></i> Delete Payment
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
