@model PaintERP.Models.Entities.Warehouse
@{
    ViewData["Title"] = "Delete Warehouse";
}

<link rel="stylesheet" href="~/css/bill.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Delete Warehouse</h1>
            <p class="page-subtitle">Confirm deletion of warehouse</p>
        </div>
        <div class="header-right">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="icon-arrow-left"></i>
                Back to Warehouses
            </a>
        </div>
    </div>

    <div class="bill-layout">
        <div class="bill-main">
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Confirm Deletion</div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Are you sure you want to delete this warehouse? This action cannot be undone.
                    </div>

                    <div class="details-grid">
                        <div class="detail-item">
                            <label>Warehouse Name:</label>
                            <span>@Model.Name</span>
                        </div>
                        <div class="detail-item">
                            <label>Location:</label>
                            <span>@Model.Location</span>
                        </div>
                        <div class="detail-item">
                            <label>Company:</label>
                            <span>@Model.Company?.Name</span>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-danger">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="icon-x"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-top: 20px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-item label {
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
    }

    .detail-item span {
        font-size: 14px;
        font-weight: 500;
        color: #1a1a1a;
    }

    .form-actions {
        display: flex;
        gap: 12px;
    }
</style>
