@model PaintERP.Models.ViewModels.PaginatedList<PaintERP.Models.ViewModels.GRNListItem>
@{
    ViewData["Title"] = "Goods Received Notes";
    ViewData["Action"] = "Index";
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Goods Received Notes</h1>
            <p class="page-subtitle">Manage incoming inventory receipts</p>
        </div>
        <div class="header-right">
            <a asp-action="Create" class="btn btn-primary">
                <i class="icon-plus"></i>
                New GRN
            </a>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GRN Number</th>
                            <th>PO Number</th>
                            <th>Vendor</th>
                            <th>GRN Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Posted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grn in Model)
                        {
                            <tr>
                                <td><strong>@grn.GRNNumber</strong></td>
                                <td>@grn.PONumber</td>
                                <td>@grn.VendorName</td>
                                <td>@grn.GRNDate.ToString("MM/dd/yyyy")</td>
                                <td>@grn.TotalAmount.ToString("C")</td>
                                <td>
                                    <span class="status-badge status-@grn.Status.ToLower()">@grn.Status</span>
                                </td>
                                <td>@grn.ItemsCount</td>
                                <td>
                                    @if (grn.IsPosted)
                                    {
                                        <span class="badge badge-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@grn.Id" class="btn-icon" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (!grn.IsPosted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@grn.Id" class="btn-icon" title="Edit">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <form asp-action="Post" asp-route-id="@grn.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-icon btn-success" title="Post GRN" onclick="return confirm('Post this GRN to update inventory?');">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
</div>
