@model PaintERP.Models.Entities.PaintProduction
@{
    ViewData["Title"] = "Delete Production Run";
}

<div class="page-header">
    <h1>Delete Production Run</h1>
</div>

<div class="content-card">
    <div class="card-body">
        <h3>Are you sure you want to delete this production run?</h3>
        
        <div class="details-grid">
            <div class="detail-item">
                <label>Production Number</label>
                <span>@Model.ProductionNumber</span>
            </div>
            <div class="detail-item">
                <label>Batch Number</label>
                <span>@Model.BatchNumber</span>
            </div>
            <div class="detail-item">
                <label>Recipe</label>
                <span>@Model.Recipe</span>
            </div>
            <div class="detail-item">
                <label>Production Date</label>
                <span>@Model.ProductionDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
            </div>
            <div class="detail-item">
                <label>Output Quantity</label>
                <span>@Model.OutputQuantity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
            </div>
            <div class="detail-item">
                <label>Status</label>
                <span>@Model.Status</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="action-bar">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
