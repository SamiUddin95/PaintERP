@model PaintERP.Models.ViewModels.PaintProductionFormViewModel
@{
    ViewData["Title"] = "New Paint Production";

    // Raw material options are rendered once on the server and cloned by the browser for new rows
    var optionsBuilder = new System.Text.StringBuilder();
    optionsBuilder.Append("<option value=\"\">Select Material</option>");
    foreach (var paintItem in Model.PaintItems)
    {
        optionsBuilder.Append("<option value=\"")
            .Append(paintItem.Id)
            .Append("\" data-cost=\"")
            .Append(paintItem.UnitCost.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))
            .Append("\" data-stock=\"")
            .Append(paintItem.CurrentStock.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))
            .Append("\" data-warehouse=\"")
            .Append(paintItem.WarehouseId)
            .Append("\" data-uom=\"")
            .Append(System.Net.WebUtility.HtmlEncode(paintItem.UnitOfMeasure))
            .Append("\" data-name=\"")
            .Append(System.Net.WebUtility.HtmlEncode(paintItem.Name))
            .Append("\">")
            .Append(System.Net.WebUtility.HtmlEncode(paintItem.Name))
            .Append(" (")
            .Append(System.Net.WebUtility.HtmlEncode(paintItem.SKU))
            .Append(") - ")
            .Append(paintItem.CurrentStock.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
            .Append(' ')
            .Append(System.Net.WebUtility.HtmlEncode(paintItem.UnitOfMeasure))
            .Append(" in stock</option>");
    }
    var materialOptionsHtml = optionsBuilder.ToString();
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">New Paint Production</h1>
            <p class="page-subtitle">Create a new paint mixing batch</p>
        </div>
        <div class="header-right">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="icon-arrow-left"></i>
                Back to Production
            </a>
        </div>
    </div>

    <form method="post" class="bill-form" asp-action="Create">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="bill-layout">
            <div class="bill-main">
                <!-- Production Header -->
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Production Header</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="ProductionNumber">Production Number</label>
                                <input asp-for="ProductionNumber" class="form-control" readonly>
                            </div>
                            <div class="form-group">
                                <label class="required" asp-for="BatchNumber">Batch Number</label>
                                <input asp-for="BatchNumber" class="form-control" placeholder="Enter batch number">
                                <span asp-validation-for="BatchNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="required" asp-for="Recipe">Recipe</label>
                                <input asp-for="Recipe" class="form-control" placeholder="Enter recipe">
                                <span asp-validation-for="Recipe" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="required" asp-for="ProductionDate">Production Date</label>
                                <input asp-for="ProductionDate" type="date" class="form-control">
                                <span asp-validation-for="ProductionDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="required" asp-for="WarehouseId">Warehouse</label>
                                <select asp-for="WarehouseId" class="form-control">
                                    <option value="">Select Warehouse</option>
                                    @foreach (var warehouse in Model.Warehouses)
                                    {
                                        <option value="@warehouse.Id">@warehouse.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="WarehouseId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="required" asp-for="OutputQuantity">Output Quantity</label>
                                <input asp-for="OutputQuantity" type="number" step="0.01" class="form-control" placeholder="0.00">
                                <span asp-validation-for="OutputQuantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="FinishedProductId">Finished Product</label>
                                <select asp-for="FinishedProductId" class="form-control" id="finishedProductSelect" onchange="toggleNewItemForm()">
                                    <option value="">Select Finished Product</option>
                                    @foreach (var item in Model.PaintItems)
                                    {
                                        <option value="@item.Id">@item.Name (@item.SKU)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="FormulaId">Formula</label>
                                <select asp-for="FormulaId" class="form-control">
                                    <option value="">Select Formula</option>
                                    @foreach (var formula in Model.Formulas)
                                    {
                                        <option value="@formula.Id">@formula.FormulaName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <div class="checkbox-wrapper">
                                    <input asp-for="CreateNewItem" class="form-check-input" id="createNewItemCheckbox" onchange="toggleNewItemForm()" />
                                    <label asp-for="CreateNewItem" class="form-check-label">Create New Item from Production</label>
                                </div>
                            </div>
                        </div>
                        
                        <!-- New Item Details Form (Hidden by default) -->
                        <div id="newItemForm" class="content-card" style="display: none;">
                            <div class="card-header">
                                <div class="card-title">New Item Details</div>
                            </div>
                            <div class="card-body">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="required" asp-for="NewItemDetails.Name">Item Name</label>
                                        <input asp-for="NewItemDetails.Name" class="form-control" placeholder="Enter new item name">
                                        <span asp-validation-for="NewItemDetails.Name" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="NewItemDetails.SKU">SKU</label>
                                        <input asp-for="NewItemDetails.SKU" class="form-control" placeholder="Auto-generated if empty">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label asp-for="NewItemDetails.Category">Category</label>
                                        <input asp-for="NewItemDetails.Category" class="form-control" placeholder="Finished Product">
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="NewItemDetails.UnitOfMeasure">Unit of Measure</label>
                                        <select asp-for="NewItemDetails.UnitOfMeasure" class="form-control">
                                            <option value="GAL">Gallon (GAL)</option>
                                            <option value="QT">Quart (QT)</option>
                                            <option value="PT">Pint (PT)</option>
                                            <option value="L">Liter (L)</option>
                                            <option value="ML">Milliliter (ML)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label asp-for="NewItemDetails.SellingPrice">Selling Price</label>
                                        <input asp-for="NewItemDetails.SellingPrice" type="number" step="0.01" class="form-control" placeholder="0.00">
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="NewItemDetails.CalculatedUnitCost">Calculated Unit Cost</label>
                                        <input asp-for="NewItemDetails.CalculatedUnitCost" type="number" step="0.01" class="form-control" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="NewItemDetails.Description">Description</label>
                                    <textarea asp-for="NewItemDetails.Description" class="form-control" rows="2" placeholder="Enter item description"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="FinishedProductDescription">Finished Product Description</label>
                                <input asp-for="FinishedProductDescription" class="form-control" placeholder="Enter description">
                                <span asp-validation-for="FinishedProductDescription" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Status">Status</label>
                                <input asp-for="Status" class="form-control" readonly value="Pending" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Raw Materials -->
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Raw Materials</div>
                        <div class="card-actions">
                            <button type="button" class="btn btn-sm btn-secondary" onclick="addMaterial()">
                                <i class="icon-plus"></i>
                                Add Material
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeLastMaterial()">
                                <i class="icon-trash"></i>
                                Delete Row
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div style="overflow-x: auto;">
                            <table class="table table-bordered" style="width: 100%; min-width: 900px; border-collapse: collapse;">
                                <thead>
                                    <tr style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
                                        <th style="width: 120px; padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Material Type</th>
                                        <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Material</th>
                                        <th style="width: 100px; padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">% in Mix</th>
                                        <th style="width: 110px; padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Required Qty</th>
                                        <th style="width: 70px; padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Unit</th>
                                        <th style="width: 110px; padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Unit Cost</th>
                                        <th style="width: 110px; padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.75px; border-bottom: 1px solid #e2e8f0;">Total Cost</th>
                                        <th style="width: 40px; padding: 12px; border-bottom: 1px solid #e2e8f0;"></th>
                                    </tr>
                                </thead>
                                <tbody id="materialsContainer">
                                    @for (int i = 0; i < Model.Materials.Count; i++)
                                    {
                                        <tr class="material-row" data-index="@i" data-selected="@(Model.Materials[i].PaintItemId?.ToString() ?? "")" style="border-bottom: 1px solid #e2e8f0;">
                                            <input type="hidden" asp-for="Materials[i].Id">
                                            <input type="hidden" asp-for="Materials[i].PaintProductionId">
                                            <input type="hidden" asp-for="Materials[i].ConsumedQuantity" class="consumed-qty">

                                            <td style="padding: 10px; vertical-align: middle;">
                                                <select asp-for="Materials[i].MaterialType" class="form-control form-control-sm material-type">
                                                    <option value="">Select Type</option>
                                                    <option value="Toner">Toner</option>
                                                    <option value="Base">Base</option>
                                                    <option value="Hardener">Hardener</option>
                                                    <option value="Thinner">Thinner</option>
                                                    <option value="Additive">Additive</option>
                                                    <option value="Pigment">Pigment</option>
                                                </select>
                                                <input type="hidden" asp-for="Materials[i].MaterialName" class="material-name">
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle;">
                                                <select asp-for="Materials[i].PaintItemId" class="form-control form-control-sm paint-item-select" onchange="onMaterialSelected(this)">
                                                    @Html.Raw(materialOptionsHtml)
                                                </select>
                                                <small class="stock-hint text-muted"></small>
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle;">
                                                <input asp-for="Materials[i].PercentageInMix" type="number" step="0.01" class="form-control form-control-sm percentage">
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle; text-align: right;">
                                                <input asp-for="Materials[i].RequiredQuantity" type="number" step="0.0001" min="0" class="form-control form-control-sm required-qty" oninput="calculateProductionMaterial(this)" style="text-align: right;">
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle;">
                                                <select asp-for="Materials[i].Unit" class="form-control form-control-sm unit-input" onchange="onUnitChanged(this)">
                                                    <option value="">Select Unit</option>
                                                    <option value="L">L (Liter)</option>
                                                    <option value="mL">mL (Milliliter)</option>
                                                    <option value="GAL">GAL (Gallon)</option>
                                                    <option value="QT">QT (Quart)</option>
                                                    <option value="PT">PT (Pint)</option>
                                                    <option value="KG">KG (Kilogram)</option>
                                                    <option value="G">G (Gram)</option>
                                                    <option value="LB">LB (Pound)</option>
                                                    <option value="OZ">OZ (Ounce)</option>
                                                    <option value="Each">Each</option>
                                                </select>
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle; text-align: right;">
                                                <input asp-for="Materials[i].UnitCost" type="number" step="0.0001" min="0" class="form-control form-control-sm unit-cost" oninput="calculateProductionMaterial(this)" style="text-align: right;">
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle; text-align: right;">
                                                <input asp-for="Materials[i].TotalCost" type="number" step="0.01" class="form-control form-control-sm total-cost" readonly style="text-align: right;">
                                            </td>
                                            <td style="padding: 10px; vertical-align: middle; text-align: center;">
                                                <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterial(this)">
                                                    <i class="icon-x"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <template id="materialOptionsTemplate">@Html.Raw(materialOptionsHtml)</template>
                        </div>
                    </div>
                </div>

                <!-- Cost Summary -->
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Cost Summary</div>
                    </div>
                    <div class="card-body">
                        <div class="summary-row">
                            <label>Material Cost</label>
                            <input asp-for="MaterialCost" type="number" step="0.01" class="form-control summary-input" readonly>
                        </div>
                        <div class="summary-row">
                            <label>Labor Cost</label>
                            <input asp-for="LaborCost" type="number" step="0.01" min="0" class="form-control summary-input" oninput="calculateProductionCost()">
                        </div>
                        <div class="summary-row">
                            <label>Overhead Cost</label>
                            <input asp-for="OverheadCost" type="number" step="0.01" min="0" class="form-control summary-input" oninput="calculateProductionCost()">
                        </div>
                        <div class="summary-row summary-total">
                            <label>Production Cost</label>
                            <input asp-for="ProductionCost" type="number" step="0.01" class="form-control summary-input" readonly>
                        </div>
                        <div class="summary-row">
                            <label>Finished Product Cost</label>
                            <input asp-for="FinishedProductCost" type="number" step="0.01" class="form-control summary-input" readonly>
                        </div>
                        <div class="summary-row">
                            <label>Cost Per Unit</label>
                            <input asp-for="CostPerUnit" type="number" step="0.01" class="form-control summary-input" readonly>
                        </div>
                    </div>
                </div>

                <!-- Quality Control -->
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Quality Control</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label asp-for="BatchLabel">Batch Label</label>
                                <input asp-for="BatchLabel" class="form-control">
                            </div>
                            <div class="form-group">
                                <label asp-for="QCStatus">QC Status</label>
                                <select asp-for="QCStatus" class="form-control">
                                    <option value="">Select Status</option>
                                    @foreach (var status in Model.QCStatusOptions)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="QCReport">QC Report</label>
                            <textarea asp-for="QCReport" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="QCNotes">QC Notes</label>
                            <textarea asp-for="QCNotes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Notes</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="ProductionNotes">Production Notes</label>
                            <textarea asp-for="ProductionNotes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bill-sidebar">
                <div class="content-card">
                    <div class="card-header">
                        <div class="card-title">Production Summary</div>
                    </div>
                    <div class="card-body">
                        <div class="sidebar-info">
                            <label>Production Number</label>
                            <div class="info-value">@Model.ProductionNumber</div>
                        </div>
                        <div class="sidebar-info">
                            <label>Status</label>
                            <div class="info-value">@Model.Status</div>
                        </div>
                        <div class="sidebar-info">
                            <label>Total Materials</label>
                            <div class="info-value" id="totalMaterialsCount">@Model.Materials.Count</div>
                        </div>
                        <div class="sidebar-info">
                            <label>Total Cost</label>
                            <div class="info-value" id="sidebarTotalCost">$@Model.ProductionCost.ToString("F2")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-bar">
            <button type="submit" class="btn btn-primary">
                <i class="icon-save"></i>
                Save Production
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="icon-x"></i>
                Cancel
            </a>
        </div>
    </form>
</div>

<script>
    let materialIndex = @Model.Materials.Count;

    // Option markup is rendered by the server once and cloned for every new row
    const materialOptionsMarkup = document.getElementById('materialOptionsTemplate').innerHTML;

    function addMaterial() {
        const container = document.getElementById('materialsContainer');
        const index = materialIndex++;

        const materialHtml = `
            <div class="item-row" data-index="${index}">
                <input type="hidden" name="Materials[${index}].Id" value="0">
                <input type="hidden" name="Materials[${index}].PaintProductionId" value="0">
                <input type="hidden" name="Materials[${index}].ConsumedQuantity" class="consumed-qty" value="0">

                <div class="col-material-type">
                    <select name="Materials[${index}].MaterialType" class="form-control form-control-sm material-type">
                        <option value="">Select Type</option>
                        <option value="Toner">Toner</option>
                        <option value="Base">Base</option>
                        <option value="Hardener">Hardener</option>
                        <option value="Thinner">Thinner</option>
                        <option value="Additive">Additive</option>
                        <option value="Pigment">Pigment</option>
                    </select>
                    <input type="hidden" name="Materials[${index}].MaterialName" class="material-name">
                </div>
                <div class="col-material">
                    <select name="Materials[${index}].PaintItemId" class="form-control form-control-sm paint-item-select" onchange="onMaterialSelected(this)">
                        ${materialOptionsMarkup}
                    </select>
                    <small class="stock-hint text-muted"></small>
                </div>
                <div class="col-percentage">
                    <input name="Materials[${index}].PercentageInMix" type="number" step="0.01" class="form-control form-control-sm percentage">
                </div>
                <div class="col-qty">
                    <input name="Materials[${index}].RequiredQuantity" type="number" step="0.0001" min="0" class="form-control form-control-sm required-qty" oninput="calculateProductionMaterial(this)">
                </div>
                <div class="col-unit">
                    <select name="Materials[${index}].Unit" class="form-control form-control-sm unit-input" onchange="onUnitChanged(this)">
                        <option value="">Select Unit</option>
                        <option value="L">L (Liter)</option>
                        <option value="mL">mL (Milliliter)</option>
                        <option value="GAL">GAL (Gallon)</option>
                        <option value="QT">QT (Quart)</option>
                        <option value="PT">PT (Pint)</option>
                        <option value="KG">KG (Kilogram)</option>
                        <option value="G">G (Gram)</option>
                        <option value="LB">LB (Pound)</option>
                        <option value="OZ">OZ (Ounce)</option>
                        <option value="Each">Each</option>
                    </select>
                </div>
                <div class="col-cost">
                    <input name="Materials[${index}].UnitCost" type="number" step="0.0001" min="0" class="form-control form-control-sm unit-cost" oninput="calculateProductionMaterial(this)">
                </div>
                <div class="col-total">
                    <input name="Materials[${index}].TotalCost" type="number" step="0.01" class="form-control form-control-sm total-cost" readonly>
                </div>
                <div class="col-action">
                    <button type="button" class="btn-icon btn-danger" onclick="removeMaterial(this)">
                        <i class="icon-x"></i>
                    </button>
                </div>
            </div>
        `;

        container.insertAdjacentHTML('beforeend', materialHtml);
        filterMaterialsByWarehouse();
        updateMaterialCount();
    }

    function selectedOptionOf(select) {
        return select && select.selectedIndex >= 0 ? select.options[select.selectedIndex] : null;
    }

    // Only materials stocked in the selected warehouse can be consumed
    function filterMaterialsByWarehouse() {
        const warehouseId = document.getElementById('WarehouseId').value;

        document.querySelectorAll('#materialsContainer .paint-item-select').forEach(select => {
            let clearedSelection = false;

            Array.from(select.options).forEach(option => {
                if (!option.value) {
                    return;
                }

                const matches = !warehouseId || option.getAttribute('data-warehouse') === warehouseId;
                option.hidden = !matches;
                option.disabled = !matches;

                if (!matches && select.value === option.value) {
                    clearedSelection = true;
                }
            });

            if (clearedSelection) {
                select.value = '';
                onMaterialSelected(select);
            }
        });
    }

    function onMaterialSelected(select) {
        const row = select.closest('.item-row');
        const option = selectedOptionOf(select);
        const unitCostInput = row.querySelector('.unit-cost');
        const materialNameInput = row.querySelector('.material-name');
        const unitInput = row.querySelector('.unit-input');

        if (option && option.value) {
            unitCostInput.value = option.getAttribute('data-cost') || '0';
            materialNameInput.value = option.getAttribute('data-name') || '';
            const unitValue = option.getAttribute('data-uom') || '';
            // Set dropdown value
            unitInput.value = unitValue;
        } else {
            unitCostInput.value = '';
            materialNameInput.value = '';
            unitInput.value = '';
        }

        calculateProductionMaterial(select);
    }

    function onUnitChanged(select) {
        const row = select.closest('.item-row');
        const materialSelect = row.querySelector('.paint-item-select');
        const selectedOption = materialSelect ? materialSelect.options[materialSelect.selectedIndex] : null;
        const originalUnit = selectedOption ? selectedOption.getAttribute('data-uom') : '';
        const newUnit = select.value;

        if (originalUnit && newUnit && originalUnit !== newUnit) {
            // Show warning that unit cost will be adjusted
            const unitCostInput = row.querySelector('.unit-cost');
            const originalCost = parseFloat(unitCostInput.value) || 0;

            if (originalCost > 0) {
                // Store original unit for reference
                select.dataset.originalUnit = originalUnit;
                select.dataset.originalCost = originalCost;

                // Show warning message
                const warningDiv = row.querySelector('.unit-warning') || document.createElement('small');
                warningDiv.className = 'unit-warning text-warning';
                warningDiv.style.display = 'block';
                warningDiv.style.marginTop = '4px';
                warningDiv.textContent = `⚠️ Unit changed from ${originalUnit} to ${newUnit}. Cost will be adjusted automatically.`;

                if (!row.querySelector('.unit-warning')) {
                    select.parentNode.appendChild(warningDiv);
                }
            }
        } else {
            // Remove warning if unit matches original
            const warningDiv = row.querySelector('.unit-warning');
            if (warningDiv) {
                warningDiv.remove();
            }
        }

        calculateProductionMaterial(select);
    }

    function removeMaterial(button) {
        const row = button.closest('.item-row');
        if (row) {
            row.remove();
            calculateMaterialCost();
            updateMaterialCount();
        }
    }

    function removeLastMaterial() {
        const rows = document.querySelectorAll('#materialsContainer .item-row');
        if (!rows.length) {
            return;
        }

        rows[rows.length - 1].remove();
        calculateMaterialCost();
        updateMaterialCount();
    }

    function calculateProductionMaterial(element) {
        const row = element.closest('.item-row');
        const qtyInput = row.querySelector('.required-qty');
        const requiredQty = parseFloat(qtyInput.value) || 0;
        const unitCost = parseFloat(row.querySelector('.unit-cost').value) || 0;

        // A single-step production consumes exactly what it requires
        row.querySelector('.consumed-qty').value = requiredQty;
        row.querySelector('.total-cost').value = (requiredQty * unitCost).toFixed(2);

        updateStockHint(row);
        calculateMaterialCost();
    }

    function updateStockHint(row) {
        const select = row.querySelector('.paint-item-select');
        const hint = row.querySelector('.stock-hint');
        const qtyInput = row.querySelector('.required-qty');
        const option = selectedOptionOf(select);

        if (!hint) {
            return;
        }

        if (!option || !option.value) {
            hint.textContent = '';
            qtyInput.classList.remove('is-invalid');
            return;
        }

        const available = parseFloat(option.getAttribute('data-stock')) || 0;
        const uom = option.getAttribute('data-uom') || '';
        const requested = parseFloat(qtyInput.value) || 0;

        if (requested > available) {
            hint.textContent = `Only ${available} ${uom} available`;
            hint.classList.add('text-danger');
            qtyInput.classList.add('is-invalid');
        } else {
            hint.textContent = `Available: ${available} ${uom}`;
            hint.classList.remove('text-danger');
            qtyInput.classList.remove('is-invalid');
        }
    }

    function calculateMaterialCost() {
        let materialCost = 0;

        document.querySelectorAll('#materialsContainer .total-cost').forEach(input => {
            materialCost += parseFloat(input.value) || 0;
        });

        document.getElementById('MaterialCost').value = materialCost.toFixed(2);
        calculateProductionCost();
        updateSidebarTotalCost();
    }

    function calculateProductionCost() {
        const materialCost = parseFloat(document.getElementById('MaterialCost').value) || 0;
        const laborCost = parseFloat(document.getElementById('LaborCost').value) || 0;
        const overheadCost = parseFloat(document.getElementById('OverheadCost').value) || 0;

        const productionCost = materialCost + laborCost + overheadCost;
        document.getElementById('ProductionCost').value = productionCost.toFixed(2);
        calculateCostPerUnit();
    }

    function calculateCostPerUnit() {
        const productionCost = parseFloat(document.getElementById('ProductionCost').value) || 0;
        const outputQty = parseFloat(document.getElementById('OutputQuantity').value) || 0;

        const costPerUnit = outputQty > 0 ? productionCost / outputQty : 0;
        document.getElementById('CostPerUnit').value = costPerUnit.toFixed(2);
        document.getElementById('FinishedProductCost').value = productionCost.toFixed(2);
        calculateNewItemUnitCost();
    }

    function updateMaterialCount() {
        const count = document.querySelectorAll('#materialsContainer .item-row').length;
        document.getElementById('totalMaterialsCount').textContent = count;
    }

    function updateSidebarTotalCost() {
        const productionCost = parseFloat(document.getElementById('ProductionCost').value) || 0;
        document.getElementById('sidebarTotalCost').textContent = '$' + productionCost.toFixed(2);
    }

    function toggleNewItemForm() {
        const checkbox = document.getElementById('createNewItemCheckbox');
        const newItemForm = document.getElementById('newItemForm');
        const finishedProductSelect = document.getElementById('finishedProductSelect');
        
        if (checkbox.checked) {
            newItemForm.style.display = 'block';
            finishedProductSelect.value = '';
            finishedProductSelect.disabled = true;
            calculateNewItemUnitCost();
        } else {
            newItemForm.style.display = 'none';
            finishedProductSelect.disabled = false;
        }
    }

    function calculateNewItemUnitCost() {
        const calculatedUnitCostInput = document.getElementById('NewItemDetails_CalculatedUnitCost');
        if (!calculatedUnitCostInput) {
            return;
        }

        const productionCost = parseFloat(document.getElementById('ProductionCost').value) || 0;
        const outputQty = parseFloat(document.getElementById('OutputQuantity').value) || 0;

        calculatedUnitCostInput.value = (outputQty > 0 ? productionCost / outputQty : 0).toFixed(4);
    }

    function validateBeforeSubmit(event) {
        const errors = [];
        const rows = Array.from(document.querySelectorAll('#materialsContainer .item-row'));

        const usableRows = rows.filter(row => {
            const select = row.querySelector('.paint-item-select');
            const qty = parseFloat(row.querySelector('.required-qty').value) || 0;
            return select.value && qty > 0;
        });

        if (usableRows.length === 0) {
            errors.push('Add at least one raw material with a quantity greater than zero.');
        }

        usableRows.forEach(row => {
            const option = selectedOptionOf(row.querySelector('.paint-item-select'));
            const available = parseFloat(option.getAttribute('data-stock')) || 0;
            const requested = parseFloat(row.querySelector('.required-qty').value) || 0;

            if (requested > available) {
                errors.push(`${option.getAttribute('data-name')}: only ${available} ${option.getAttribute('data-uom')} in stock, ${requested} requested.`);
            }
        });

        const duplicates = usableRows
            .map(row => row.querySelector('.paint-item-select').value)
            .filter((value, index, all) => all.indexOf(value) !== index);

        if (duplicates.length > 0) {
            errors.push('The same raw material is selected on more than one row. Combine them into a single line.');
        }

        if ((parseFloat(document.getElementById('OutputQuantity').value) || 0) <= 0) {
            errors.push('Output quantity must be greater than zero.');
        }

        const createNewItem = document.getElementById('createNewItemCheckbox').checked;
        const newItemName = document.getElementById('NewItemDetails_Name');

        if (createNewItem && (!newItemName || !newItemName.value.trim())) {
            errors.push('Enter a name for the new item.');
        }

        if (!createNewItem && !document.getElementById('finishedProductSelect').value) {
            errors.push("Select a finished product or tick 'Create New Item from Production'.");
        }

        if (errors.length > 0) {
            event.preventDefault();
            alert(errors.join('\n'));
            return false;
        }

        return true;
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Restore any selection that came back from the server (e.g. after a validation error)
        document.querySelectorAll('#materialsContainer .item-row').forEach(row => {
            const paintItemSelect = row.querySelector('.paint-item-select');
            const selected = row.getAttribute('data-selected');

            if (paintItemSelect && selected) {
                paintItemSelect.value = selected;
            }
        });

        filterMaterialsByWarehouse();

        document.querySelectorAll('#materialsContainer .item-row').forEach(row => {
            const select = row.querySelector('.paint-item-select');
            if (select && select.value) {
                onMaterialSelected(select);
            }
        });

        document.getElementById('WarehouseId').addEventListener('change', filterMaterialsByWarehouse);
        document.getElementById('OutputQuantity').addEventListener('input', calculateCostPerUnit);
        document.querySelector('form.bill-form').addEventListener('submit', validateBeforeSubmit);

        toggleNewItemForm();
        calculateMaterialCost();
        updateMaterialCount();
    });
</script>

@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
