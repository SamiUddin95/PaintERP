@model PaintERP.Models.Entities.InventoryTransfer
@{
    ViewData["Title"] = "Inventory Transfer Details";
}

<link rel="stylesheet" href="/css/bill.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Inventory Transfer Details</h1>
            <p class="page-subtitle">@Model.TransferNumber</p>
        </div>
        <div class="header-right">
            <a class="btn btn-secondary" asp-action="Index">
                <i class="icon-arrow-left"></i>
                Back to Transfers
            </a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="icon-edit"></i> Edit
            </a>
        </div>
    </div>

    <div class="bill-layout">
        <div class="bill-main">
            <!-- Header -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Transfer Information</div>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Transfer Number</label>
                            <input value="@Model.TransferNumber" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Transfer Date</label>
                            <input value="@Model.TransferDate.ToString("yyyy-MM-dd")" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Source Warehouse</label>
                            <input value="@Model.SourceWarehouse?.Name" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Destination Warehouse</label>
                            <input value="@Model.DestinationWarehouse?.Name" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Status</label>
                            <input value="@Model.Status" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Tracking Number</label>
                            <input value="@Model.TrackingNumber" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Shipped By</label>
                            <input value="@Model.ShippedBy" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Received By</label>
                            <input value="@Model.ReceivedBy" class="form-control" readonly />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="form-group">
                            <label>Notes</label>
                            <textarea class="form-control" rows="3" readonly>@Model.Notes</textarea>
                        </div>
                    }
                </div>
            </div>

            <!-- Items -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Transfer Items</div>
                </div>
                <div class="card-body">
                    <div class="items-grid">
                        <div class="items-header">
                            <div class="col-item">SKU</div>
                            <div class="col-desc">Description</div>
                            <div class="col-qty">Quantity</div>
                            <div class="col-unit">Unit</div>
                            <div class="col-batch">Batch Number</div>
                        </div>
                        @foreach (var item in Model.InventoryTransferItems)
                        {
                            <div class="item-row">
                                <div class="col-item">@item.SKU</div>
                                <div class="col-desc">@item.Description</div>
                                <div class="col-qty">@item.Quantity</div>
                                <div class="col-unit">@item.Unit</div>
                                <div class="col-batch">@item.BatchNumber</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="bill-sidebar">
            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Status Timeline</div>
                </div>
                <div class="card-body">
                    @if (Model.ApprovedAtUtc.HasValue)
                    {
                        <div class="status-item">
                            <label>Approved At</label>
                            <input value="@Model.ApprovedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")" class="form-control" readonly />
                        </div>
                    }
                    @if (Model.ShippedAtUtc.HasValue)
                    {
                        <div class="status-item">
                            <label>Shipped At</label>
                            <input value="@Model.ShippedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")" class="form-control" readonly />
                        </div>
                    }
                    @if (Model.ReceivedAtUtc.HasValue)
                    {
                        <div class="status-item">
                            <label>Received At</label>
                            <input value="@Model.ReceivedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")" class="form-control" readonly />
                        </div>
                    }
                </div>
            </div>

            <div class="content-card">
                <div class="card-header">
                    <div class="card-title">Actions</div>
                </div>
                <div class="card-body">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-block">
                        <i class="icon-edit"></i> Edit Transfer
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-block mt-2">
                        <i class="icon-trash"></i> Delete Transfer
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
