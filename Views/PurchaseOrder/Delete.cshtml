@model PaintERP.Models.Entities.PurchaseOrder
@{
    ViewData["Title"] = "Delete Purchase Order";
}

<div class="page-header">
    <h1>Delete Purchase Order</h1>
</div>

<div class="content-card">
    <div class="card-body">
        <h3>Are you sure you want to delete this purchase order?</h3>
        
        <div class="details-grid">
            <div class="detail-item">
                <label>PO Number</label>
                <span>@Model.PONumber</span>
            </div>
            <div class="detail-item">
                <label>Vendor</label>
                <span>@Model.Vendor?.BusinessName</span>
            </div>
            <div class="detail-item">
                <label>Order Date</label>
                <span>@Model.OrderDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="detail-item">
                <label>Total Amount</label>
                <span>@Model.TotalAmount.ToString("C2")</span>
            </div>
            <div class="detail-item">
                <label>Status</label>
                <span>@Model.Status</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="action-bar">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
