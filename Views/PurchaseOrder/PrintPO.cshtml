@model PaintERP.Models.Entities.PurchaseOrder
@{
    ViewData["Title"] = $"Purchase Order {Model.PONumber}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .po-container {
            max-width: 800px;
            margin: 0 auto;
        }
        .print-button {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 10px 20px;
            background: #333;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
        @@media print {
            .print-button { display: none; }
            body { padding: 0; }
            .po-container { max-width: 100%; }
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
</head>
<body>
    <button class="print-button" onclick="window.print()">Print PO</button>

    <div class="po-container">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
            <tr>
                <td width="60%" valign="top">
                    <h1 style="font-size: 18px; color: #333; margin: 0 0 5px 0;">Unicorp Auto Paints</h1>
                    <p style="margin: 0; font-size: 12px; line-height: 1.4;">
                        1821 Thonig Rd<br />
                        Houston, TX 77055-2510<br />
                        USA<br />
                        unicorpgezi@gmail.com
                    </p>
                </td>
                <td width="40%" valign="top" style="text-align: right;">
                    <div style="background-color: #5a2d7c; color: white; padding: 10px 15px; font-size: 20px; font-weight: bold; margin-bottom: 5px;">
                        Purchase Order @Model.PONumber
                    </div>
                    <div style="background-color: #7b4e9e; color: white; padding: 5px 15px; font-size: 14px;">
                        PO DATE @Model.OrderDate.ToString("MM/dd/yyyy")
                    </div>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
            <tr>
                <td width="50%" valign="top" style="padding-right: 20px;">
                    <div style="border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
                        <strong style="font-size: 12px; color: #333;">VENDOR</strong><br />
                        <strong>@Model.Vendor?.BusinessName</strong><br />
                        @if (!string.IsNullOrEmpty(Model.Vendor?.BusinessStreetAddress))
                        {
                            @Model.Vendor.BusinessStreetAddress<br />
                        }
                        @if (!string.IsNullOrEmpty(Model.Vendor?.BusinessCity))
                        {
                            @Model.Vendor.BusinessCity<br />
                        }
                        @if (!string.IsNullOrEmpty(Model.Vendor?.BusinessState))
                        {
                            @Model.Vendor.BusinessState<br />
                        }
                        @if (!string.IsNullOrEmpty(Model.Vendor?.BusinessZipCode))
                        {
                            @Model.Vendor.BusinessZipCode
                        }
                    </div>
                </td>
                <td width="50%" valign="top" style="padding-left: 20px;">
                    <div style="border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
                        <strong style="font-size: 12px; color: #333;">SHIP TO</strong><br />
                        <strong>Unicorp Auto Paints</strong><br />
                        @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                        {
                            @Model.ShippingAddress
                        }
                        else
                        {
                            @:1821 Thonig Rd<br />
                            @:Houston, TX 77055-2510
                        }
                    </div>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="8" cellspacing="0" border="1" style="border-collapse: collapse; margin-bottom: 20px; border: 1px solid #333;">
            <tr style="background-color: #5a2d7c; color: white;">
                <th style="text-align: left; font-size: 11px; padding: 8px;">ACTIVITY</th>
                <th style="text-align: left; font-size: 11px; padding: 8px;">DESCRIPTION</th>
                <th style="text-align: center; font-size: 11px; padding: 8px; width: 60px;">QTY</th>
                <th style="text-align: right; font-size: 11px; padding: 8px; width: 80px;">RATE</th>
                <th style="text-align: right; font-size: 11px; padding: 8px; width: 90px;">AMOUNT</th>
            </tr>
            @foreach (var item in Model.PurchaseOrderItems)
            {
                <tr>
                    <td style="padding: 8px; font-size: 11px;">@item.SKU</td>
                    <td style="padding: 8px; font-size: 11px;">@item.Description</td>
                    <td style="padding: 8px; font-size: 11px; text-align: center;">@item.QuantityOrdered.ToString("N2")</td>
                    <td style="padding: 8px; font-size: 11px; text-align: right;">@item.UnitCost.ToString("N2")</td>
                    <td style="padding: 8px; font-size: 11px; text-align: right;">@item.LineTotal.ToString("N2")</td>
                </tr>
            }
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td>&nbsp;</td>
                <td width="200" valign="top" align="right">
                    <table width="200" cellpadding="5" cellspacing="0" border="0">
                        <tr>
                            <td align="left" style="font-size: 11px; color: #333;">SUBTOTAL</td>
                            <td align="right" style="font-size: 11px; color: #333;">@Model.Subtotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td align="left" style="font-size: 11px; color: #333;">Discount</td>
                            <td align="right" style="font-size: 11px; color: #333;">-@Model.DiscountAmount.ToString("N2")</td>
                        </tr>
                        <tr style="background-color: #5a2d7c; color: white;">
                            <td align="left" style="font-size: 12px; font-weight: bold; padding: 8px 5px;">TOTAL</td>
                            <td align="right" style="font-size: 14px; font-weight: bold; padding: 8px 5px;">$@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ccc;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td width="50%" valign="top">
                        <p style="margin: 0 0 5px 0; font-size: 12px; font-weight: bold; color: #333;">Approved By</p>
                        <div style="border-bottom: 1px solid #333; width: 200px; height: 30px;"></div>
                    </td>
                    <td width="50%" valign="top">
                        <p style="margin: 0 0 5px 0; font-size: 12px; font-weight: bold; color: #333;">Date</p>
                        <div style="border-bottom: 1px solid #333; width: 200px; height: 30px;"></div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>
