@model PaintERP.Models.Entities.Vendor
@{
    ViewData["Title"] = "Delete Vendor";
}

<section class="vendor-delete-wrapper">
    <div class="delete-card">
        <div class="delete-header">
            <h1>Delete Vendor</h1>
            <p>Are you sure you want to delete this vendor? This action cannot be undone.</p>
        </div>

        <div class="vendor-summary">
            <div class="summary-item">
                <span>Vendor ID</span>
                <strong>@Model.VendorId</strong>
            </div>
            <div class="summary-item">
                <span>Business Name</span>
                <strong>@Model.BusinessName</strong>
            </div>
            <div class="summary-item">
                <span>Vendor Type</span>
                <strong>@Model.VendorType</strong>
            </div>
            <div class="summary-item">
                <span>Status</span>
                <strong>@(Model.IsActive ? "Active" : "Inactive")</strong>
            </div>
            <div class="summary-item">
                <span>Outstanding Balance</span>
                <strong>@Model.OutstandingAmount.ToString("C")</strong>
            </div>
            <div class="summary-item">
                <span>Total Purchase Orders</span>
                <strong>@Model.TotalPurchaseOrders</strong>
            </div>
            <div class="summary-item">
                <span>Total Bills</span>
                <strong>@Model.TotalBills</strong>
            </div>
        </div>

        <form asp-controller="Vendor" asp-action="Delete" method="post" class="delete-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="danger-btn">Confirm Delete</button>
            <a asp-action="Index" class="ghost-btn">Cancel</a>
        </form>
    </div>
</section>
