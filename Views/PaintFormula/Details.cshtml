@model PaintERP.Models.Entities.PaintFormula
@{
    ViewData["Title"] = "Paint Formula Details";
}

<link rel="stylesheet" href="/css/bill.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Paint Formula Details</h1>
            <p class="page-subtitle">View paint recipe and formula information</p>
        </div>
        <div class="header-right">
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header">
            <div class="card-title">Formula Information</div>
            <div class="card-actions">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            </div>
        </div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <label>Formula Code</label>
                    <span>@Model.FormulaCode</span>
                </div>
                <div class="detail-item">
                    <label>Formula Name</label>
                    <span>@Model.FormulaName</span>
                </div>
                <div class="detail-item">
                    <label>Paint Color</label>
                    <span>@Model.PaintColor</span>
                </div>
                <div class="detail-item">
                    <label>Finish</label>
                    <span>@Model.Finish</span>
                </div>
                <div class="detail-item">
                    <label>Container Size</label>
                    <span>@Model.ContainerSize</span>
                </div>
                <div class="detail-item">
                    <label>Version</label>
                    <span>@Model.Version</span>
                </div>
                <div class="detail-item">
                    <label>Status</label>
                    <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
                </div>
                <div class="detail-item">
                    <label>Total Formula Cost</label>
                    <span>@Model.TotalFormulaCost.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <label>Expected Yield</label>
                    <span>@Model.ExpectedYield.ToString("F2")</span>
                </div>
                <div class="detail-item">
                    <label>Waste Percentage</label>
                    <span>@Model.WastePercentage.ToString("F2")%</span>
                </div>
                <div class="detail-item">
                    <label>Selling Price</label>
                    <span>@(Model.SellingPrice.ToString("C") ?? "N/A")</span>
                </div>
                <div class="detail-item">
                    <label>Gross Margin</label>
                    <span>@Model.GrossMargin.ToString("F2")%</span>
                </div>
                <div class="detail-item">
                    <label>Created At</label>
                    <span>@Model.CreatedAtUtc.ToLocalTime():MMM dd, yyyy h\:mm tt</span>
                </div>
                <div class="detail-item">
                    <label>Updated At</label>
                    <span>@Model.UpdatedAtUtc.ToLocalTime():MMM dd, yyyy h\:mm tt</span>
                </div>
                <div class="detail-item">
                    <label>Created By</label>
                    <span>@Model.CreatedBy</span>
                </div>
                <div class="detail-item">
                    <label>Updated By</label>
                    <span>@Model.UpdatedBy</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="content-card">
            <div class="card-header">
                <div class="card-title">Formula Items</div>
            </div>
            <div class="card-body">
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Raw Material</th>
                                <th>Percentage</th>
                                <th>Required Quantity</th>
                                <th>Unit</th>
                                <th>Unit Cost</th>
                                <th>Inventory Available</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.RawMaterialName</td>
                                    <td>@item.Percentage.ToString("F2")%</td>
                                    <td>@item.RequiredQuantity.ToString("F2")</td>
                                    <td>@item.Unit</td>
                                    <td>@item.UnitCost.ToString("C")</td>
                                    <td>@item.InventoryAvailable.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
