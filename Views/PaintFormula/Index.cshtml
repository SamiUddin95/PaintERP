@model IEnumerable<PaintERP.Models.Entities.PaintFormula>
@{
    ViewData["Title"] = "Paint Formulas";
}

<link rel="stylesheet" href="/css/bill.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">Paint Formulas</h1>
            <p class="page-subtitle">Manage paint recipes, BOMs, and production formulas</p>
        </div>
        <div class="header-right">
            <a class="btn btn-primary" asp-action="Create">
                <i class="icon-plus"></i>
                New Formula
            </a>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header">
            <div class="card-title">All Formulas</div>
            <div class="card-actions">
                <input type="text" class="search-input" placeholder="Search formulas..." />
            </div>
        </div>
        <div class="card-body">
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Formula Code</th>
                            <th>Formula Name</th>
                            <th>Paint Color</th>
                            <th>Finish</th>
                            <th>Container</th>
                            <th>Version</th>
                            <th>Status</th>
                            <th>Cost</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a class="link-primary" asp-action="Details" asp-route-id="@item.Id">@item.FormulaCode</a>
                                </td>
                                <td>@item.FormulaName</td>
                                <td>@item.PaintColor</td>
                                <td>@item.Finish</td>
                                <td>@item.ContainerSize</td>
                                <td>@item.Version</td>
                                <td>
                                    <span class="status-badge status-@item.Status.ToLower()">@item.Status</span>
                                </td>
                                <td>@item.TotalFormulaCost.ToString("C")</td>
                                <td>
                                    <div class="action-buttons">
                                        <a class="btn-icon" title="Edit" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="icon-edit"></i>
                                        </a>
                                        <a class="btn-icon btn-danger" title="Delete" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="icon-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
